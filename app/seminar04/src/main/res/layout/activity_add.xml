<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".AddActivity">

    <EditText
        android:id="@+id/nr_locuri_et"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/numarul_de_locuri"
        android:importantForAutofill="no"
        android:inputType="number" />

    <EditText
        android:id="@+id/culoare_et"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/culoare"
        android:importantForAutofill="no"
        android:inputType="text" />

    <CheckBox
        android:id="@+id/are_veste_cb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/are_veste" />

    <EditText
        android:id="@+id/marca_et"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/marca"
        android:importantForAutofill="no"
        android:inputType="text" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/are_motor_sw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/are_motor" />

    <Button
        android:id="@+id/add_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:onClick="addBarca"
        android:text="@string/adauga_barca" />

</LinearLayout>